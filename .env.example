# Puerto del servidor
PORT=3000

# Rutas a archivos CSV (para producción con Dropbox sync)
# DNI_CSV_PATH=/path/to/Dropbox/ConnectingPrion/priocohort/databases/dni.csv
# TXPR_CSV_PATH=/path/to/Dropbox/ConnectingPrion/priocohort/databases/txpr.csv

# Ruta para guardar consentimientos firmados (para producción con Dropbox sync)
# SIGNED_CONSENTS_PATH=/path/to/Dropbox/ConnectingPrion/priocohort/Signed CI

# Dropbox API Configuration
# Obtén estas credenciales en: https://www.dropbox.com/developers/apps
#
# OPCIÓN 1: Usar Refresh Token (RECOMENDADO para producción)
# Con esta opción el token se renueva automáticamente
DROPBOX_REFRESH_TOKEN=your_refresh_token_here
DROPBOX_APP_KEY=your_app_key_here
DROPBOX_APP_SECRET=your_app_secret_here
#
# OPCIÓN 2: Usar Access Token estático (más simple pero expira)
# Si usas esta opción, comenta las variables de arriba
# DROPBOX_ACCESS_TOKEN=your_access_token_here

# Email para recibir CI firmados
CONTACT_EMAIL=jcastilla@cicbiogune.es